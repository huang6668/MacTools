            "state": "translated",
            "value": "Barra de menús"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra de menus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка меню"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شريط القوائم"
          }
        }
      }
    },
    "settings.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arc shows battery, the dots show Wi-Fi signal, and the bottom shows volume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧显示电量，圆点显示 Wi-Fi 信号，底部显示音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓弧顯示電量，圓點顯示 Wi-Fi 訊號，底部顯示音量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧はバッテリー、ドットは Wi-Fi 信号、下部は音量を表します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원호는 배터리, 점은 Wi-Fi 신호, 하단은 음량을 나타냅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bogen zeigt die Batterie, die Punkte das WLAN-Signal und unten die Lautstärke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arc indique la batterie, les points le signal Wi-Fi et le bas le volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El arco muestra la batería, los puntos la señal Wi-Fi y la parte inferior el volumen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arco mostra a bateria, os pontos o sinal Wi-Fi e a parte inferior o volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга показывает заряд, точки — сигнал Wi-Fi, а нижняя часть — громкость."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض القوس البطارية، والنقاط إشارة Wi-Fi، والجزء السفلي مستوى الصوت."
          }
        }
      }
    },
    "settings.placement": {
