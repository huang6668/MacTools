    "settings.networkFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the matching network state shows a dedicated icon instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开启时，对应网络状态改为显示专用图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟時，對應網路狀態改為顯示專用圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、該当するネットワーク状態は専用アイコンで表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 해당 네트워크 상태에 전용 아이콘이 대신 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, zeigt der jeweilige Netzwerkzustand stattdessen ein eigenes Symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si désactivé, l’état réseau correspondant affiche une icône dédiée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, el estado de red correspondiente muestra un icono específico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, o estado de rede correspondente mostra um ícone dedicado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, для соответствующего состояния сети показывается отдельный значок."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، تُعرض أيقونة مخصصة لحالة الشبكة المقابلة."
          }
        }
      }
    },
