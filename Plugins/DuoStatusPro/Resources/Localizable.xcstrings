    "settings.bluetoothGlyphReplacesNetworkIconDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a Bluetooth mark while a Bluetooth audio device is in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用蓝牙音频设备时显示蓝牙标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用藍牙音訊裝置時顯示藍牙標記。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth オーディオ機器の使用中に Bluetooth マークを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블루투스 오디오 기기를 사용할 때 블루투스 표시를 보여줍니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Bluetooth-Markierung, solange ein Bluetooth-Audiogerät verwendet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une marque Bluetooth lorsqu’un appareil audio Bluetooth est utilisé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una marca Bluetooth mientras se usa un dispositivo de audio Bluetooth."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra uma marca Bluetooth enquanto um dispositivo de áudio Bluetooth está em uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает значок Bluetooth, пока используется аудиоустройство Bluetooth."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض علامة Bluetooth أثناء استخدام جهاز صوت Bluetooth."
