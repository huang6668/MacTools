    "metadata.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi, battery, and volume combined into one menu bar icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi、电量与音量合一的菜单栏图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi、電量與音量合一的選單列圖示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi、バッテリー、音量をひとつのメニューバーアイコンに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi, 배터리, 음량을 하나의 메뉴 막대 아이콘으로"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WLAN, Batterie und Lautstärke in einem Menüleistensymbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi, batterie et volume réunis dans une seule icône de la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi, batería y volumen en un solo icono de la barra de menús."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi, bateria e volume num único ícone da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi, батарея и громкость в одном значке строки меню."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi والبطارية ومستوى الصوت في أيقونة واحدة في شريط القوائم."
          }
        }
      }
    },
    "settings.menuBar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Bar"
          }
        },
