    "settings.standaloneDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown separately. Hover for status, click to open settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立显示，悬停查看状态，点击打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立顯示，游標停留查看狀態，點按打開設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立して表示します。ホバーで状態を確認し、クリックで設定を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도로 표시됩니다. 마우스를 올리면 상태를 확인하고 클릭하면 설정이 열립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird separat angezeigt. Status beim Überfahren, Klick öffnet die Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichée séparément. Survolez pour l’état, cliquez pour ouvrir les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra por separado. Pasa el cursor para ver el estado y haz clic para abrir los ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrado em separado. Passe o cursor para ver o estado e clique para abrir as definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается отдельно. Наведите для просмотра состояния, нажмите для открытия настроек."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض بشكل مستقل. مرّر المؤشر لعرض الحالة وانقر لفتح الإعدادات."
          }
        }
      }
    },
    "settings.primaryDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces the MacTools icon. Click behavior stays the same."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换 MacTools 主图标，点击行为保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代 MacTools 主圖示，點按行為保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools のメインアイコンを置き換えます。クリック時の動作は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 기본 아이콘을 대체합니다. 클릭 동작은 그대로입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt das MacTools-Symbol. Das Klickverhalten bleibt gleich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace l’icône MacTools. Le comportement au clic reste identique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza el icono de MacTools. El comportamiento al hacer clic no cambia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o ícone do MacTools. O comportamento ao clicar mantém-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет значок MacTools. Поведение при нажатии не меняется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل أيقونة MacTools. يبقى سلوك النقر كما هو."
          }
        }
      }
    },
    "settings.occupiedPendingRestartFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is waiting for a restart. Restart MacTools, then adjust its icon settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在等待重启。请重启 MacTools 后调整其图标设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在等待重新啟動。請重新啟動 MacTools 後調整其圖示設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は再起動を待機中です。MacTools を再起動してからアイコン設定を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 재시동을 기다리고 있습니다. MacTools를 재시동한 후 아이콘 설정을 조정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wartet auf einen Neustart. Starte MacTools neu und passe dann die Symboleinstellungen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » attend un redémarrage. Redémarrez MacTools, puis modifiez ses réglages d’icône."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está esperando un reinicio. Reinicia MacTools y luego ajusta su configuración de icono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está à espera de reinício. Reinicie o MacTools e depois ajuste as definições do ícone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ожидает перезапуска. Перезапустите MacTools, затем измените настройки его значка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» في انتظار إعادة التشغيل. أعد تشغيل MacTools ثم اضبط إعدادات أيقونته."
          }
        }
      }
    },
    "settings.occupiedFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app icon is already used by “%@”. Turn off replacement in its settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用图标已由「%@」使用。请先在其设置中取消替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 圖示已由「%@」使用。請先在其設定中取消取代。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリアイコンは「%@」が使用中です。先にその設定で置き換えを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 아이콘을 이미 “%@”이(가) 사용 중입니다. 먼저 해당 설정에서 대체를 해제하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Symbol wird bereits von „%@“ verwendet. Deaktiviere zuerst dort die Ersetzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de l’app est déjà utilisée par « %@ ». Désactivez d’abord le remplacement dans ses réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de la app ya lo usa “%@”. Desactiva primero el reemplazo en su configuración."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone da app já está a ser usado por “%@”. Desative primeiro a substituição nas suas definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок приложения уже используется «%@». Сначала отключите замену в его настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيقونة التطبيق مستخدمة بالفعل من «%@». عطّل الاستبدال في إعداداته أولًا."
          }
        }
      }
    },
    "settings.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display mode can’t be changed right now. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法切换显示方式，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法切換顯示方式，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は表示方法を切り替えられません。しばらくしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 표시 방식을 변경할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Darstellung kann gerade nicht geändert werden. Versuche es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer le mode d’affichage pour le moment. Réessayez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar el modo de visualización ahora. Inténtalo más tarde."
          }
        },
        "pt": {
