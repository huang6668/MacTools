    "settings.usesBatteryStatusColorsDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low battery, charging, and Low Power Mode use distinct colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量、充电与低电量模式使用不同颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低電量、充電與低耗電模式使用不同顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低残量、充電中、低電力モードを異なる色で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 부족, 충전, 저전력 모드를 서로 다른 색으로 표시합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger Ladestand, Laden und Stromsparmodus verwenden eigene Farben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie faible, charge et mode Économie d’énergie utilisent des couleurs distinctes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batería baja, carga y modo de bajo consumo usan colores distintos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria fraca, carregamento e modo de baixo consumo usam cores distintas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Низкий заряд, зарядка и режим энергосбережения выделяются разными цветами."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم ألوان مختلفة للبطارية المنخفضة والشحن ونمط الطاقة المنخفضة."
          }
        }
      }
    },
