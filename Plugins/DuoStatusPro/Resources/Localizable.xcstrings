          }
        }
      }
    },
    "settings.primary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace App Icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换应用图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代 App 圖示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリアイコンを置き換え"
          }
        },
        "ko": {
