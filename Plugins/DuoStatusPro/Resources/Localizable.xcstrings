          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络异常时仍显示网络状态而非蓝牙标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路異常時仍顯示網路狀態而非藍牙標記。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに問題がある場合は Bluetooth マークではなくネットワーク状態を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 문제가 있으면 블루투스 표시 대신 네트워크 상태를 계속 표시합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt bei Netzwerkproblemen weiterhin den Netzwerkstatus statt der Bluetooth-Markierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue d’afficher l’état réseau plutôt que la marque Bluetooth en cas de problème réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue mostrando el estado de red en lugar de la marca Bluetooth cuando hay un problema de red."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a mostrar o estado da rede em vez da marca Bluetooth quando a rede tem um problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При проблемах с сетью продолжает показывать состояние сети вместо значка Bluetooth."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر في عرض حالة الشبكة بدلًا من علامة Bluetooth عند وجود مشكلة في الشبكة."
          }
        }
      }
    },
